# Placeholder-only local Google Classroom pilot configuration.
# Copy values into ignored .env.local/.env files or export them in your shell.
# server.app auto-loads .env.local then .env without overriding process env vars.
# Never commit real client secrets, refresh tokens, access tokens, auth codes, or OAuth JSON.

GOOGLE_OAUTH_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-web-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/auth/callback

# Optional: load a Google Web OAuth client JSON kept outside the repository.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=/absolute/path/outside/repo/client_secret.json

# Optional: required for strict/staging token storage. Local development without
# this key stores tokens under ignored server/data/google_oauth as plaintext.
GOOGLE_TOKEN_ENCRYPTION_KEY=
